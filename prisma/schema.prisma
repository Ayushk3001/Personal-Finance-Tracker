generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  income
  expense
}

enum TransactionType {
  income
  expense
}

enum BudgetPeriod {
  daily
  weekly
  monthly
  yearly
}

enum GoalPriority {
  low
  medium
  high
}

model User {
  id             Int           @id @default(autoincrement())
  username       String        @unique @db.VarChar(50)
  email          String        @unique @db.VarChar(100)
  password_hash  String        @db.VarChar(255)
  first_name     String?       @db.VarChar(100)
  last_name      String?       @db.VarChar(100)
  avatar_url     String?       @db.VarChar(255)
  currency       String        @default("INR") @db.VarChar(3)
  timezone       String        @default("UTC") @db.VarChar(50)
  monthly_budget Decimal?      @db.Decimal(12, 2)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  last_login     DateTime?
  is_active      Boolean       @default(true)
  budgets        Budget[]
  categories     Category[]
  sessions       Session[]
  savings_goals  SavingsGoal[]
  transactions   Transaction[]

  @@index([email], map: "idx_email")
  @@index([username], map: "idx_username")
  @@map("users")
}

model Category {
  id           Int           @id @default(autoincrement())
  user_id      Int
  name         String        @db.VarChar(100)
  type         CategoryType
  color        String        @default("#000000") @db.VarChar(7)
  icon         String?       @db.VarChar(50)
  description  String?
  is_active    Boolean       @default(true)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  budgets      Budget[]
  transactions Transaction[]
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, name, type], map: "unique_category")
  @@index([user_id, type], map: "idx_user_type")
  @@map("categories")
}

model Transaction {
  id                  Int             @id @default(autoincrement())
  user_id             Int
  category_id         Int
  description         String          @db.VarChar(255)
  amount              Decimal         @db.Decimal(12, 2)
  transaction_date    DateTime        @db.Date
  type                TransactionType
  payment_method      String?         @db.VarChar(50)
  notes               String?
  receipt_url         String?         @db.VarChar(255)
  is_recurring        Boolean         @default(false)
  recurring_frequency String?         @db.VarChar(50)
  recurring_end_date  DateTime?       @db.Date
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  category            Category        @relation(fields: [category_id], references: [id], onDelete: Restrict)
  user                User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([category_id], map: "idx_category")
  @@index([type], map: "idx_type")
  @@index([user_id, transaction_date], map: "idx_transactions_month")
  @@map("transactions")
}

model Budget {
  id              Int          @id @default(autoincrement())
  user_id         Int
  category_id     Int?
  name            String       @db.VarChar(100)
  limit_amount    Decimal      @db.Decimal(12, 2)
  spent_amount    Decimal      @default(0) @db.Decimal(12, 2)
  period          BudgetPeriod @default(monthly)
  start_date      DateTime     @db.Date
  end_date        DateTime?    @db.Date
  alert_threshold Int          @default(80)
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  category        Category?    @relation(fields: [category_id], references: [id], onDelete: SetNull)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_active], map: "idx_budgets_active")
  @@index([user_id, period], map: "idx_user_period")
  @@map("budgets")
}

model SavingsGoal {
  id             Int          @id @default(autoincrement())
  user_id        Int
  name           String       @db.VarChar(100)
  description    String?
  target_amount  Decimal      @db.Decimal(12, 2)
  current_amount Decimal      @default(0) @db.Decimal(12, 2)
  target_date    DateTime?    @db.Date
  priority       GoalPriority @default(medium)
  category       String?      @db.VarChar(50)
  icon           String?      @db.VarChar(50)
  color          String       @default("#000000") @db.VarChar(7)
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  user           User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_active], map: "idx_user_active")
  @@map("savings_goals")
}

model Session {
  id         String   @id @default(uuid()) @db.VarChar(255)
  user_id    Int
  token      String   @unique @db.VarChar(255)
  user_agent String?  @db.VarChar(255)
  ip_address String?  @db.VarChar(45)
  created_at DateTime @default(now())
  expires_at DateTime
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at], map: "idx_user_expires")
  @@map("sessions")
}
